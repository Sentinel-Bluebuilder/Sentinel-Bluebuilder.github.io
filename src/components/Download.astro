---
const platforms = [
  {
    id: 'ios',
    label: 'iOS',
    icon: '/media/apple.svg',
    apps: [
      { name: 'DVPN by NORSE',    href: 'https://apps.apple.com/' },
      { name: 'encryptSIM',       href: 'https://apps.apple.com/' },
      { name: 'Independent dVPN', href: 'https://apps.apple.com/' },
      { name: 'Ryn VPN',          href: 'https://apps.apple.com/' },
      { name: 'Sentinel Shield',  href: 'https://apps.apple.com/' },
      { name: 'VALT',             href: 'https://apps.apple.com/' },
    ],
  },
  {
    id: 'android',
    label: 'Android',
    icon: '/media/android.svg',
    apps: [
      { name: 'DVPN by NORSE',    href: 'https://play.google.com/' },
      { name: 'Independent dVPN', href: 'https://play.google.com/' },
      { name: 'Ryn VPN',          href: 'https://play.google.com/' },
      { name: 'Sentinel Shield',  href: 'https://play.google.com/' },
    ],
  },
  {
    id: 'desktop',
    label: 'Desktop',
    icon: '/media/desktop.svg',
    apps: [
      { name: 'Meile dVPN (macOS)',   href: 'https://github.com/MathNodes/meile-gui' },
      { name: 'Meile dVPN (Linux)',   href: 'https://github.com/MathNodes/meile-gui' },
      { name: 'Meile dVPN (Windows)', href: 'https://github.com/MathNodes/meile-gui' },
    ],
  },
  {
    id: 'tv',
    label: 'TV',
    icon: '/media/tv.svg',
    apps: [
      { name: 'Sentinel Shield (Android TV)', href: 'https://play.google.com/' },
    ],
  },
];
---
<section id="download" class="section download">
  <div class="container">
    <div class="dl__head">
      <span class="eyebrow">Sentinel dVPN</span>
      <h2>Use open-source decentralized VPN apps you can trust.</h2>
      <p class="dl__intro">
        Pick your platform, pick a dVPN. Every app on this list ships on the Sentinel network &mdash;
        no single provider owns the bandwidth you route through.
      </p>
    </div>

    <div class="dl__panel">
      <div class="dl__tabs" role="tablist">
        {platforms.map((p, i) => (
          <button
            type="button"
            role="tab"
            class={`dl__tab${i === 0 ? ' is-active' : ''}`}
            data-target={p.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <img src={p.icon} alt="" width="18" height="18" />
            <span>{p.label}</span>
          </button>
        ))}
      </div>

      {platforms.map((p, i) => (
        <div class={`dl__list${i === 0 ? ' is-active' : ''}`} data-panel={p.id} role="tabpanel">
          {p.apps.map(app => (
            <a class="dl__app" href={app.href} target="_blank" rel="noopener">
              <span class="dl__app-icon">
                <img src="/logos/shield-icon.svg" alt="" width="20" height="20" />
              </span>
              <span class="dl__app-name">{app.name}</span>
              <span class="dl__app-cta">Connect to dVPN <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const tabs = document.querySelectorAll('#download .dl__tab');
    const panels = document.querySelectorAll('#download .dl__list');
    tabs.forEach(t => t.addEventListener('click', () => {
      const target = t.getAttribute('data-target');
      tabs.forEach(x => {
        const active = x === t;
        x.classList.toggle('is-active', active);
        x.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(p => p.classList.toggle('is-active', p.getAttribute('data-panel') === target));
    }));
  })();
</script>

<style>
  .download { border-top: 1px solid var(--border); }
  .dl__head { max-width: 720px; margin-bottom: 36px; }
  .dl__intro { font-size: 1.08rem; }

  .dl__panel {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 22px;
    box-shadow: 0 30px 60px -30px var(--accent-glow);
  }

  .dl__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 4px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .dl__tab {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 8px;
    background: transparent;
    border: 0;
    color: var(--text-mute);
    font-family: var(--font-display);
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .dl__tab img { filter: brightness(0) invert(1); opacity: 0.6; }
  .dl__tab:hover { color: var(--text); }
  .dl__tab.is-active {
    background: var(--accent);
    color: #fff;
  }
  .dl__tab.is-active img { opacity: 1; }

  .dl__list { display: none; flex-direction: column; gap: 10px; }
  .dl__list.is-active { display: flex; }

  .dl__app {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .dl__app:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    background: var(--bg-card-2);
  }
  .dl__app-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(1,86,252,0.14);
    border: 1px solid var(--border-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .dl__app-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.02rem;
  }
  .dl__app-cta {
    color: var(--accent-2);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .dl__app { grid-template-columns: auto 1fr; }
    .dl__app-cta { grid-column: 1 / -1; padding-left: 56px; }
  }
</style>
