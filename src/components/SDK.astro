---
const platforms = [
  { name: 'iOS',      icon: '/media/apple.svg',   note: 'Swift / React Native' },
  { name: 'Android',  icon: '/media/android.svg', note: 'Kotlin / React Native' },
  { name: 'macOS',    icon: '/media/desktop.svg', note: 'Swift / Electron' },
  { name: 'Linux',    icon: '/media/desktop.svg', note: 'CLI / daemon' },
  { name: 'Windows',  icon: '/media/desktop.svg', note: 'Electron / .NET' },
  { name: 'Web',      icon: '/media/globe.svg',   note: 'TypeScript / WASM' },
  { name: 'TV',       icon: '/media/tv.svg',      note: 'Android TV / tvOS' },
  { name: 'Server',   icon: '/logos/overview/network.svg', note: 'Node / Go SDK' },
];
---
<section id="sdk" class="section sdk">
  <div class="container">
    <div class="sdk__head">
      <span class="eyebrow">SDK</span>
      <h2>Build your own dVPN app on multi-platform SDKs.</h2>
      <p class="sdk__intro">
        The Sentinel SDK ships native bindings for every platform users actually live on. Bring your UI,
        your protocol, your brand &mdash; we handle the bandwidth, routing, and payments.
      </p>
    </div>

    <div class="sdk__layout">
      <div class="sdk__platforms">
        {platforms.map(p => (
          <div class="sdk__platform">
            <div class="sdk__icon"><img src={p.icon} alt="" width="22" height="22" /></div>
            <div class="sdk__platform-meta">
              <strong>{p.name}</strong>
              <span>{p.note}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="sdk__code">
        <div class="sdk__code-head">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="sdk__code-title">my-dvpn-app.ts</span>
        </div>
<pre><code>{`import { SentinelClient } from '@sentinel/sdk';

const client = new SentinelClient({
  protocol: 'wireguard',   // or 'v2ray', 'openvpn'
  plan:     'pro-monthly', // your Plan Manager plan id
});

// Pick the best node, connect, and route traffic.
const session = await client.connect({ region: 'auto' });
console.log('Connected via', session.node.country);`}</code></pre>
      </div>
    </div>

    <div class="sdk__cta">
      <a href="https://docs.sentinel.co/sdk" target="_blank" rel="noopener" class="btn btn--primary">SDK Docs</a>
      <a href="https://github.com/sentinel-official" target="_blank" rel="noopener" class="btn">View on GitHub</a>
    </div>
  </div>
</section>

<style>
  .sdk { border-top: 1px solid var(--border); }
  .sdk__head { max-width: 720px; margin-bottom: 40px; }
  .sdk__intro { font-size: 1.08rem; }

  .sdk__layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 36px;
    align-items: stretch;
  }

  .sdk__platforms {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .sdk__platform {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .sdk__platform:hover { border-color: var(--accent); transform: translateY(-1px); }
  .sdk__icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(1,86,252,0.14);
    border: 1px solid var(--border-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sdk__icon img { filter: brightness(0) invert(1); opacity: 0.85; }
  .sdk__platform-meta { display: flex; flex-direction: column; }
  .sdk__platform-meta strong { color: var(--text); font-family: var(--font-display); font-weight: 500; }
  .sdk__platform-meta span { color: var(--text-mute); font-size: 0.85rem; }

  .sdk__code {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .sdk__code-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 6px 14px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 14px;
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .dot:nth-child(1) { background: #ff5f57; }
  .dot:nth-child(2) { background: #febc2e; }
  .dot:nth-child(3) { background: #28c840; }
  .sdk__code-title { margin-left: 10px; color: var(--text-mute); font-size: 0.85rem; }
  .sdk__code pre {
    margin: 0;
    padding: 4px 8px 8px;
    overflow-x: auto;
    color: #c8d1de;
    font-size: 0.86rem;
    line-height: 1.6;
    font-family: 'SF Mono', ui-monospace, Menlo, Consolas, monospace;
  }

  .sdk__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  @media (max-width: 900px) {
    .sdk__layout { grid-template-columns: 1fr; }
  }
</style>
